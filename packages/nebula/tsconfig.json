{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDirs": ["./src", "../rosetta/src"],
    "baseUrl": ".",
    "paths": {
      "@celestial/nebula": ["./src/index.ts"],
      "@celestial/nebula/*": ["./src/*"],
      "@celestial/rosetta": ["../rosetta/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist"]
}
