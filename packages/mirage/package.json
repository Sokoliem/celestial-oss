{
  "name": "@celestial/mirage",
  "version": "0.1.0-preview.1",
  "description": "Accessible gradients and visual effects for Celestial terminal applications",
  "keywords": ["tui", "terminal", "typescript", "celestial", "text-effects", "gradient", "shimmer"],
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/Sokoliem/celestial-oss.git", "directory": "packages/mirage" },
  "homepage": "https://github.com/Sokoliem/celestial-oss/tree/master/packages/mirage",
  "bugs": { "url": "https://github.com/Sokoliem/celestial-oss/issues" },
  "publishConfig": { "access": "public" },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.cjs" } },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run --config vitest.preview.config.ts",
    "test:watch": "vitest --config vitest.preview.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": { "@celestial/aurora": "workspace:*", "@celestial/corona": "workspace:*", "@celestial/nebula": "workspace:*", "@celestial/rosetta": "workspace:*" },
  "devDependencies": { "tsup": "^8.3.0", "typescript": "^5.7.0", "vitest": "^2.1.0" },
  "engines": { "node": ">=22.0.0" },
  "sideEffects": false
}
