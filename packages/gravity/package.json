{
  "name": "@celestial/gravity",
  "version": "0.1.0-preview.2",
  "description": "Responsive flex/grid layout engine for the Celestial TUI ecosystem",
  "keywords": [
    "tui",
    "terminal",
    "cli",
    "typescript",
    "celestial",
    "layout",
    "flexbox",
    "grid",
    "responsive"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sokoliem/celestial-oss.git",
    "directory": "packages/gravity"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "require": "./dist/testing.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@celestial/aurora": "workspace:*",
    "@celestial/corona": "workspace:*",
    "@celestial/nebula": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "sideEffects": false
}
