{
  "name": "@celestial/core",
  "version": "0.1.0-preview.1",
  "description": "The stable entry point for the Celestial TypeScript TUI runtime",
  "keywords": [
    "tui",
    "terminal",
    "typescript",
    "elm-architecture",
    "terminal-ui"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sokoliem/celestial-oss.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./atlas": {
      "types": "./dist/atlas.d.ts",
      "import": "./dist/atlas.js",
      "require": "./dist/atlas.cjs"
    },
    "./corona": {
      "types": "./dist/corona.d.ts",
      "import": "./dist/corona.js",
      "require": "./dist/corona.cjs"
    },
    "./aurora": {
      "types": "./dist/aurora.d.ts",
      "import": "./dist/aurora.js",
      "require": "./dist/aurora.cjs"
    },
    "./nebula": {
      "types": "./dist/nebula.d.ts",
      "import": "./dist/nebula.js",
      "require": "./dist/nebula.cjs"
    },
    "./gravity": {
      "types": "./dist/gravity.d.ts",
      "import": "./dist/gravity.js",
      "require": "./dist/gravity.cjs"
    },
    "./nexus": {
      "types": "./dist/nexus.d.ts",
      "import": "./dist/nexus.js",
      "require": "./dist/nexus.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@celestial/atlas": "workspace:*",
    "@celestial/aurora": "workspace:*",
    "@celestial/corona": "workspace:*",
    "@celestial/gravity": "workspace:*",
    "@celestial/nebula": "workspace:*",
    "@celestial/nexus": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
